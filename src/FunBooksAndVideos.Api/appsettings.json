{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // The same everywhere. Where SQL Server and Temporal are comes from appsettings.Development.json when run from
  // source, and from environment variables in docker compose and Azure.
  "Temporal": {
    "TaskQueue": "purchase-orders",
    "AcknowledgementTimeout": "00:00:10"
  },
  "RateLimiting": {
    "SubmissionsPerMinute": 30
  }
}
