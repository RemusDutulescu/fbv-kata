        "x": 0,
        "y": 23,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Activities a second, per worker",
      "description": "One line per worker replica: docker compose up --scale worker=3 spreads the work across three.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (instance) (rate(temporal_activity_execution_latency_milliseconds_count{job=\"FunBooksAndVideos.Worker\"}[1m]))",
          "legendFormat": "{{instance}}"
        }
      ],
      "id": 15,
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Waiting for a worker, p95",
      "description": "How long a workflow task waits in Temporal's queue before a worker picks it up (schedule-to-start). It climbs when the workers fall behind, and reads 10 s at most: the histogram's top bucket. Activities don't wait: Temporal hands each straight to the worker that scheduled it.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(temporal_workflow_task_schedule_to_start_latency_milliseconds_bucket{job=\"FunBooksAndVideos.Worker\"}[1m])))",
          "legendFormat": "p95"
        }
      ],
      "id": 16,
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "CPU, per replica",
      "description": "CPU time a second, from .NET's runtime meter: 100% is one core. A worker added under load takes its share.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(sum by (job, instance) (rate(dotnet_process_cpu_time_seconds_total{job=~\"FunBooksAndVideos.*\"}[1m])), \"host\", \"$1\", \"job\", \"FunBooksAndVideos\\\\.(.*)\")",
          "legendFormat": "{{host}} {{instance}}"
        }
      ],
      "id": 17,
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Memory, per replica",
      "description": "Working set. On the homelab, each replica is capped at 512 MB.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(sum by (job, instance) (dotnet_process_memory_working_set_bytes{job=~\"FunBooksAndVideos.*\"}), \"host\", \"$1\", \"job\", \"FunBooksAndVideos\\\\.(.*)\")",
          "legendFormat": "{{host}} {{instance}}"
        }
      ],
      "id": 18,
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "row",
      "title": "Traces and logs",
      "collapsed": false,
      "panels": [],
      "id": 19,
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "table",
      "title": "Recent submissions",
      "description": "Each one's trace: the request, its workflow, every activity, rule and SQL statement. Click a trace id to open it.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"FunBooksAndVideos.Api\" && span.http.route = \"v1/purchase-orders\" && span.http.request.method = \"POST\" }",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "id": 20,
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 24,
        "h": 9
      }
    },
    {
      "type": "logs",
      "title": "Warnings and errors",
      "description": "From the API and the workers, newest first. An activity's failure is logged as a warning, and is retried.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=~\"FunBooksAndVideos.*\"} | severity_text=~\"Warning|Error|Critical\""
        }
      ],
      "id": 21,
      "gridPos": {
        "x": 0,
        "y": 50,
        "w": 24,
        "h": 10
      }
    }
  ]
